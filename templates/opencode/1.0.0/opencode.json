{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{model}}",
  "agent": {
    "code-reviewer": {
      "description": "Code reviewer agent for {{project_name}}",
      "model": "{{model}}",
      "prompt": "Review code for quality, security, and best practices."
    },
    "{{project_name}}-assistant": {
      "description": "{{project_description}}",
      "model": "{{model}}"
    }
  },
  "tools": {
    "read": true,
    "edit": true,
    "write": true,
    "bash": true,
    "glob": true,
    "grep": true
  },
  "instructions": [
    ".ai/instructions/project.md",
    ".ai/instructions/conventions.md"
  ],
  "shell": {
    "allowed_commands": [],
    "disallowed_commands": [],
    "default_timeout": 300000
  }
}
